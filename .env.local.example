# Copia este archivo a ".env.local" (ese sí lo lee Next.js) y rellena los valores reales.
# ".env.local" está en .gitignore -> nunca se sube al repo. NUNCA pongas estos valores en .env.local.example.

# --- Supabase ---
# Project Settings > API en tu dashboard de Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Antes llamada "anon key". Llave pública, segura para el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Antes llamada "service_role key" (ahora sb_secret_...). SOLO en servidor, nunca en el cliente.
SUPABASE_SECRET_KEY=

# --- Admin ---
# ÚNICO correo con acceso a /admin. Debe estar verificado en Clerk.
ADMIN_EMAIL=

# --- Clerk ---
# Dashboard de Clerk > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Rutas de Clerk. No hay página de registro a propósito: el admin es una sola
# cuenta, creada a mano desde el dashboard de Clerk.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin

# --- OpenRouter (descripción automática de fotos) ---
# Solo servidor. Se usa para sugerir una descripción a partir de la imagen;
# la sugerencia es editable y no se guarda sola.
# Alternativas medidas: mistralai/mistral-small-3.2-24b-instruct (más rápido
# y barato, calidad pareja). Vacío = openai/gpt-5.6-luna.
OPENROUTER_MODEL=

OPENROUTER_API_KEY=
